{
  "manifest_version": 3,
  "name": "Kosmos Companion",
  "version": "0.2.0",
  "description": "Prepare Kosmos contact phone numbers in Google Voice.",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://kosmos.nerdswhofish.com/*", "http://localhost/*"],
      "js": ["kosmos.js"]
    },
    {
      "matches": ["https://voice.google.com/*"],
      "js": ["voice.js"]
    }
  ]
}
